# Copy to apps/storefront/.env.local for local development.
# Server-side base URL used to reach the API (never exposed to the browser).
API_URL=http://localhost:4000
# Must match STOREFRONT_SHARED_SECRET in apps/api/.env.
STOREFRONT_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_32+
# Where the merchant admin lives (used on the platform landing page).
ADMIN_PUBLIC_URL=http://localhost:3100
