# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
APP_VERSION=0.0.0-dev
# Comma-separated browser origins allowed to call the API (admin, storefront).
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
# Shared HMAC secret (same value in apps/storefront/.env.local). At least 32 characters.
STOREFRONT_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_32+
# Stores are served at <subdomain>.<STOREFRONT_ROOT_DOMAIN>
STOREFRONT_ROOT_DOMAIN=localhost
# Payments: "mock" (sandbox, development only) or "stripe" (use TEST keys in development).
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Connect endpoint ("Events on connected accounts") -> /api/v1/webhooks/connect/stripe
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Unpaid orders release reserved stock after this many minutes.
ORDER_PAYMENT_TIMEOUT_MINUTES=30
# Encrypts secrets at rest (e.g. 2FA seeds) and signs short-lived tokens. 32+ random chars.
APP_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_32+
# Require 2FA for platform admins (defaults to true in production).
# REQUIRE_PLATFORM_2FA=true
