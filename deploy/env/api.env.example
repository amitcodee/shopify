# API + worker. The API refuses to start while any secret still contains CHANGE_ME.
NODE_ENV=production
DATABASE_URL=postgresql://shop_app:CHANGE_ME@postgres:5432/shop
DATABASE_URL_PLATFORM=postgresql://shop_platform:CHANGE_ME@postgres:5432/shop
PUBLIC_API_URL=https://api.example-commerce.com
ADMIN_PUBLIC_URL=https://admin.example-commerce.com
CORS_ORIGINS=https://admin.example-commerce.com
TRUST_PROXY=uniquelocal
STOREFRONT_ROOT_DOMAIN=example-commerce.com
STOREFRONT_PUBLIC_URL=https://{subdomain}.example-commerce.com
STOREFRONT_PROTOCOL=https
PLATFORM_CNAME_TARGET=stores.example-commerce.com
# Same value as storefront.env (HMAC proving requests come from the storefront server).
STOREFRONT_SHARED_SECRET=CHANGE_ME_32_PLUS_CHARS
APP_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_CHARS
DNS_VERIFIER=dns
REQUIRE_PLATFORM_2FA=true
# Outbound webhooks never reach private/internal addresses in production (keep false).
WEBHOOK_ALLOW_PRIVATE_URLS=false
STORAGE_DIR=/app/storage

# Email
EMAIL_TRANSPORT=postmark
POSTMARK_SERVER_TOKEN=CHANGE_ME
EMAIL_FROM=Commerce Platform <no-reply@example-commerce.com>

# Payments & billing (live keys only after a full test-mode rehearsal)
# Gateways merchants can connect (comma-separated): stripe, razorpay
PAYMENT_PROVIDERS=stripe,razorpay
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_CHANGE_ME
# Razorpay (Route enabled on the account): webhooks -> /api/v1/webhooks/payments/razorpay and
# /api/v1/webhooks/connect/razorpay, both with RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
