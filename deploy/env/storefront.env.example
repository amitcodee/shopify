# Storefront (Next.js). Only the request-signing secret; no database credentials.
NODE_ENV=production
STOREFRONT_ROOT_DOMAIN=example-commerce.com
ADMIN_PUBLIC_URL=https://admin.example-commerce.com
# Store the marketing site's template "Preview" buttons open (with ?theme_preview=<id>).
PLATFORM_DEMO_STORE_URL=https://demo.example-commerce.com
STOREFRONT_SHARED_SECRET=CHANGE_ME_32_PLUS_CHARS
