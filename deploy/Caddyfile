{
	email {$ACME_EMAIL}
	# Certificates for store hosts are only requested when the API confirms the host belongs
	# to a live store (subdomain or verified custom domain). Prevents certificate abuse.
	on_demand_tls {
		ask http://api:4000/api/v1/domains/tls-check
	}
}

admin.{$PLATFORM_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:3000
}

api.{$PLATFORM_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}

# Every other HTTPS host is a storefront.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy storefront:3000
}
